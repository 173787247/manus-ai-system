# Manus AI — 环境变量示例（UTF-8）
# 复制为 .env 后填写真实值：Windows: Copy-Item .env.example .env

# ---------- LLM（规划 / 代码 / GUI / 评估等智能体）----------
OPENAI_API_KEY=sk-your-openai-api-key-here
DEFAULT_LLM_MODEL=gpt-4
DEFAULT_VL_MODEL=gpt-4-vision-preview
TEMPERATURE=0.1

# ---------- 任务执行 ----------
MAX_STEPS=10

# ---------- Telegram 推送（可选，用于运维通知或作业截图）----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_MESSAGE=Manus AI: pipeline OK

# ---------- 成本统计日志（可选，JSON Lines）----------
# MANUS_COST_LOG=logs/manus_cost.jsonl
